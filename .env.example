# Copy to .env.
# Gemini on Vertex AI, as in Project 2: your Google Cloud project. Auth: gcloud auth application-default login
VERTEXAI_PROJECT=
VERTEX_LOCATION=global
# YouTube Data API v3 key: Google Cloud Console > APIs & Services > Credentials > Create credentials > API key
YOUTUBE_API_KEY=

# Optional overrides
# MODEL=vertex_ai/gemini-3.6-flash            # Investigator and Defense
# SMALL_MODEL=vertex_ai/gemini-3.5-flash-lite  # Reporter
# INVESTIGATOR_EFFORT=low                      # also DEFENSE_EFFORT, REPORTER_EFFORT
# MAX_COMMENTS=1000                            # newest comments and replies read per video
# MAX_INVESTIGATED=4                           # groups that get an Investigator and a Defense
# MIN_SCORE=0.35                               # signal score a group needs to be investigated
# SENTIMENT_BACKEND=transformer                # or vader (fast, rule-based)
# SENTIMENT_MODEL=cardiffnlp/twitter-roberta-base-sentiment-latest
# CACHE_DIR=data/cache                         # fetched threads; empty turns it off
